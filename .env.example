VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Frontend feature toggles (UI visibility)
# If omitted, frontend follows backend feature flags.
# If set to false, UI is hidden even when backend enables the feature.
VITE_ENABLE_INVITE_USER=true
VITE_ENABLE_ADD_USER=true
VITE_ENABLE_USER_PROJECT_ASSOCIATION=true

# Landing page — mobile app store buttons (your listing URLs; optional fallbacks used if empty)
# VITE_IOS_APP_STORE_URL=https://apps.apple.com/app/your-app/id000000000
# VITE_ANDROID_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.your.app
